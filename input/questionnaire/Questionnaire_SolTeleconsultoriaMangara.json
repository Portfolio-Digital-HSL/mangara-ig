{
  "resourceType": "Questionnaire",
  "id": "SolTeleconsultoria",
  "url": "https://ig.mangaradigital.org/apost-ig/Questionnaire/SolTeleconsultoria",
  "version": "1.0.0",
  "name": "SolTeleconsultoriaMangara",
  "title": "Solicitação de Teleconsultoria",
  "status": "draft",
  "experimental": true,
  "description": "Solicitação de teleconsultoria: pedido de apoio matricial de uma equipe do HSL a um profissional teleconsultor, sem a presença do usuário.",
  "subjectType": [
    "Patient"
  ],
  "item": [
    {
      "linkId": "SOL.DS",
      "text": "Data da Solicitação",
      "type": "date",
      "required": true
    },
    {
      "linkId": "SOL.ES",
      "text": "Estabelecimento Solicitante",
      "type": "group",
      "item": [
        {
          "linkId": "SOL.ES.CNES",
          "text": "CNES",
          "type": "string"
        },
        {
          "linkId": "SOL.ES.NM",
          "text": "Nome do Estabelecimento",
          "type": "string"
        },
        {
          "linkId": "SOL.ES.VINC",
          "text": "Polo Base e DSEI do estabelecimento",
          "type": "group",
          "readOnly": true,
          "required": false,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/designNote",
              "valueMarkdown": "Não é perguntado; preenchido a partir do CNES (SOL.ES.CNES), subindo pelos Organization.partOf: estabelecimento → Polo Base → DSEI. Busca 1: Organization?identifier=https://saude.gov.br/fhir/sid/cnes|{CNES}. Buscas 2 e 3: Organization?_id={id do partOf}. Classificação, para não depender do número de níveis: Polo Base = organização da cadeia com subtype PoloBase (extension br-core-organization-subtype); DSEI = organização da cadeia com identifier https://saude.gov.br/fhir/sid/dsei. Nem todo estabelecimento tem Polo e/ou DSEI: os campos ficam vazios. Atenção: em hml-fhir (07/10/2026) as UBSI apontam direto para o DSEI (ex.: UBSI ALDEIA VERDE, Organization/299018 → partOf Organization/298768 DSEI MGES), sem o nível do Polo."
            }
          ],
          "enableWhen": [
            {
              "question": "SOL.ES.CNES",
              "operator": "exists",
              "answerBoolean": true
            }
          ],
          "item": [
            {
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%polo.name"
                  }
                }
              ],
              "linkId": "SOL.ES.VINC.PoloNome",
              "text": "Polo Base",
              "type": "string",
              "readOnly": true,
              "required": false
            },
            {
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%polo.identifier.where(system='https://saude.gov.br/fhir/sid/polo-base').value.first()"
                  }
                }
              ],
              "linkId": "SOL.ES.VINC.PoloCodigo",
              "text": "Código do Polo Base",
              "type": "string",
              "readOnly": true,
              "required": false
            },
            {
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%dsei.name"
                  }
                }
              ],
              "linkId": "SOL.ES.VINC.DSEINome",
              "text": "DSEI",
              "type": "string",
              "readOnly": true,
              "required": false
            },
            {
              "extension": [
                {
                  "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
                  "valueExpression": {
                    "language": "text/fhirpath",
                    "expression": "%dsei.identifier.where(system='https://saude.gov.br/fhir/sid/dsei').value.first()"
                  }
                }
              ],
              "linkId": "SOL.ES.VINC.DSEICodigo",
              "text": "Código do DSEI",
              "type": "string",
              "readOnly": true,
              "required": false
            }
          ]
        }
      ]
    },
